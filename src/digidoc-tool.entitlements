<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Under the hardened runtime digidoc-tool cannot otherwise load third-party
         PKCS#11 vendor drivers. This is not an App Sandbox entitlement list, so no
         com.apple.security.network.client is needed for TSL, OCSP or TSA traffic. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
